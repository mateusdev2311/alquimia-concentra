# Variáveis do serviço (no Doca, cadastre em Variáveis do projeto; localmente, copie para .env).
# Nunca coloque valores reais neste arquivo.
# As chaves das extensões NÃO ficam aqui: são geradas na ativação, pela extensão de admin.
# A IA também não: quem lê a receita é a automação da Kentro (aiProcessFile), com o token da própria Kentro.

# Banco Postgres do Doca (o projeto precisa estar LIGADO ao banco mateus_alquimia_concentra).
DATABASE_URL=postgres://usuario:senha@apps-postgres:5432/mateus_alquimia_concentra

# Endereço público HTTPS do serviço (o mesmo domínio que vai no manifest das extensões).
URL_PUBLICA=https://concentra.kentro.com.br

# API da Concentra (servidor da farmácia). Sempre o domínio DuckDNS, nunca o IP.
CONCENTRA_API_URL=http://alquimiabraganca.duckdns.org:3000/apiconc
CONCENTRA_API_KEY=

# Opcionais
# CONCENTRA_TEMPO_LIMITE_MS=20000   tempo limite das consultas comuns
# SINCRONIZACAO=desligada           desliga a cópia automática do cadastro neste processo
# REDEFINIR_CHAVES=sim              emergência: apaga as chaves na subida para ativar de novo (tire depois)
